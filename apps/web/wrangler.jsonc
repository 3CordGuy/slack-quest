{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gantt-quest-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-12",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gantt-quest",
      "database_id": "76c6ce34-5599-4f43-80d9-9a77062a90a7",
      "migrations_dir": "../../migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "ART",
      "bucket_name": "gantt-quest-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "QUEST_ROOM", "class_name": "QuestRoom" },
      { "name": "LOBBY_ROOM", "class_name": "LobbyRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuestRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRoom"] }
  ],
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "MAIL_FROM_ADDRESS": "noreply@heylets.party",
    "MAIL_FROM_NAME": "Gantt Quest"
  }
}
