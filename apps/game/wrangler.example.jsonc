// Template for apps/game/wrangler.jsonc. The real file is gitignored.
//
// Local development needs no Cloudflare resources:
//   1. cp apps/game/wrangler.example.jsonc apps/game/wrangler.jsonc
//   2. pnpm --filter @gantt-quest/game db:migrate:local
//   3. pnpm --filter @gantt-quest/game dev
//
// AI_MODE "mock" swaps Workers AI for a scripted stand-in so the game runs
// offline and for free. Set it to "live" (and be logged in to wrangler) to
// use real models for the story, NPC replies and the epilogue.
//
// This worker has its own D1 database. It does not share the legacy
// slack-quest database used by apps/web and apps/slack.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gantt-quest-game",
  "main": "src/worker.ts",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gantt-quest-game",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": { "AI_MODE": "mock" },
  "durable_objects": {
    "bindings": [
          { "name": "RUN_ROOM", "class_name": "RunRoom" },
          { "name": "HARBOR_ROOM", "class_name": "HarborRoom" }
        ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["HarborRoom"] }
  ],
  // Staging: `CLOUDFLARE_ENV=staging pnpm build && wrangler deploy`.
  // Environments do not inherit bindings, so they are repeated here.
  "env": {
    "staging": {
      "name": "gantt-quest-game-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gantt-quest-game-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "./migrations"
        }
      ],
      "ai": { "binding": "AI" },
      // Email sign-in codes. Needs a domain onboarded under Email Service > Send
      // Emails in the Cloudflare dashboard. Leave both out and codes are written
      // to the Worker's log instead of being mailed.
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "vars": { "AI_MODE": "live", "MAIL_FROM_ADDRESS": "noreply@yourdomain.com", "MAIL_FROM_NAME": "Gantt Quest" },
      "durable_objects": {
        "bindings": [
          { "name": "RUN_ROOM", "class_name": "RunRoom" },
          { "name": "HARBOR_ROOM", "class_name": "HarborRoom" }
        ]
      }
    }
  }
}
