{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-quest",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slack-quest",
      "database_id": "REPLACE_AFTER_pnpm_db:create",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" }
}
