{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gantt-quest",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gantt-quest",
      "database_id": "REPLACE_AFTER_pnpm_db:create",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "gantt-quest-assets"
    }
  ],
  "vars": {
    "BOT_NAME": "Gantt Quest",
    "IMAGE_BASE_URL": "https://gantt-quest.3cordguy.workers.dev"
  }
}
